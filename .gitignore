# Excluir la carpeta de compilación de Maven
target/

# Archivos de logs y configuraciones locales
*.log
*.class
*.war
*.jar

# Ignorar archivos específicos de IntelliJ IDEA
/.idea/
/shelf/
/workspace.xml

# Editor-based HTTP Client requests
/httpRequests/

# Configuraciones locales de bases de datos en DataGrip u otros IDEs
/dataSources/
/dataSources.local.xml

# Evitar archivos de Maven que no son necesarios
.mvn/
!mvnw
!mvnw.cmd

# Evitar dependencias descargadas de Maven
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.versionsBackup
**/pom.xml.next
**/dependency-reduced-pom.xml
**/release.properties
**/target/

# Evitar configuraciones específicas de Docker (por seguridad)
**/docker-compose.override.yml
